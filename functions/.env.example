# Sqrrlbrain Cloud Functions — env vars
# Copy to .env (gitignored) and fill in your real values
# Or set via `firebase functions:secrets:set NAME` (preferred for production)

# --- Kit (ConvertKit) ---
# Get from: kit.com → Account → Settings → Advanced → API
KIT_API_KEY=

# Kit form ID for the unified newsletter
# Create a Form in Kit (Grow → Landing Pages & Forms → New Form)
# Configure it for double opt-in (Settings → Incentive Email → Confirmation enabled)
# Grab the numeric ID from the form URL: kit.com/forms/12345 → 12345
KIT_FORM_ID=

# --- Discord ---
# Create webhook in Discord: Server Settings → Integrations → Webhooks → New
DISCORD_WEBHOOK_URL=
