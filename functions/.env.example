# Sqrrlbrain Cloud Functions — env vars
# Copy to .env (gitignored) and fill in your real values
# Or set via `firebase functions:secrets:set NAME` (preferred for production)

# Kit (ConvertKit) — V4 API
# Get from: kit.com → Account → Settings → Advanced → API
KIT_API_KEY=

# Kit tag IDs (one per collection)
# Create the tags in Kit UI first, then grab each tag's numeric ID
# (visible in the URL when you open a tag, or via GET /v4/tags)
KIT_TAG_INKWELL=
KIT_TAG_SQRRLEDAWAY=
KIT_TAG_SITE_NOTIFY=
KIT_TAG_CONTACT=

# Discord webhook URL (for real-time signup notifications)
# Create in Discord: Server Settings → Integrations → Webhooks → New
DISCORD_WEBHOOK_URL=
